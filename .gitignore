# Local research inputs and weights; retain existing directory markers only.
/data/**
!/data/**/
!/data/**/.gitkeep
/checkpoints/**
!/checkpoints/**/
!/checkpoints/**/.gitkeep

# Generated reports, figures, predictions, caches and downloaded transfer bundles.
/output_JEVPFN/
/archived_output_JEVPFN/
/.maintenance.lock
/output/
/.cache/
/environments/
/containers/
/conda_envs/
*.sqlite3
*.sqlite3-*
*.parquet
*.arrow
*.ckpt
*.pt
*.pth
*.safetensors
*.npy
*.npz

# Python environments and build/test caches, at any depth.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Editor/OS files. Keep the shared import-path settings.
/.vscode/*
!/.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Credentials at every depth. Never store real keys in tracked config/notebook cells.
.env
.env.*
credentials.json
credentials.*
secrets.*
api_keys.*
kaggle.json
*.key
*.pem
*.p12
*.pfx
.ssh/
/secrets/
/credentials/
/config/**/*.local.yaml
