# ===========================================================================
# JEVPFN — what is never committed.
#
# ANCHORING, enforced by the compliance test: a bare `figures/` matches that name at EVERY
# depth, including `output/figures/`. So a rule naming one of the tree's directories carries a
# leading slash; the unanchored ones are those that must match anywhere (`__pycache__/`).
#
# THE `**` + DIRECTORY RE-INCLUSION IDIOM, used for data/ and output/:
#     /output/**  ignore everything under it   !/output/**/  but still DESCEND into its
#     directories   !/output/**/.gitkeep  and keep the markers
# The middle rule is load-bearing: without it git never enters `output/figures/`, the .gitkeep
# negation can never match, and a fresh clone has no output tree.
# ===========================================================================

# --- Raw and processed data ------------------------------------------------
# Raw data is irreplaceable and usually not ours to redistribute; processed data is a
# cache that any preprocessing script rebuilds. Neither belongs in git history.
/data/**
!/data/**/
!/data/**/.gitkeep

# --- Everything the code generates ----------------------------------------
# One root means one rule. The exceptions are the small text artefacts that ARE the record of
# a run and are worth having in git.
/output/**
!/output/**/
!/output/**/.gitkeep


# Figures are PDFs only, regenerated by `python scripts/run_notebooks.py`. The paper pulls
# them from a local run, not from git; the notebooks display them inline.

# --- Model weights --------------------------------------------------------
# Hundreds of MB each, and either downloaded from upstream or reproducible from a run.
/checkpoints/**
!/checkpoints/**/
!/checkpoints/**/.gitkeep
*.ckpt
*.pt
*.pth
*.safetensors
*.npz

# --- Environments and tool caches -----------------------------------------
# Unanchored on purpose: these appear at any depth and are never wanted anywhere.
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Editor and OS --------------------------------------------------------
# `.vscode/` is ignored EXCEPT settings.json. Without `python.analysis.extraPaths`, Pylance
# cannot resolve `from src.utils...` in a fresh clone (flat `src/` package root), so every
# import is underlined red until someone runs the editable install. Layout, not taste.
/.vscode/*
!/.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Local secrets and overrides ------------------------------------------
# Secrets are excluded at every depth.
.env
.env.*
credentials.json
credentials.*
secrets.*
api_keys.*
kaggle.json
*.key
*.pem
/secrets/
/credentials/

# Detailed reports contain dataset examples and complete request previews.
/output_JEVPFN/
