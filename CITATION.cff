# Machine-readable citation metadata. GitHub renders a "Cite this repository" button
# from this file, and Zenodo reads it when minting a DOI for a release — which is what
# turns "the code is on GitHub" into something a paper can actually cite.
cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "{{PROJECT_NAME}}"
abstract: "{{DESCRIPTION}}"
authors:
  - family-names: "Goethals"
    given-names: "Andreas"
    email: "{{EMAIL}}"
    affiliation: "KU Leuven"
version: "0.1.0"
date-released: "{{DATE_ISO}}"
license: MIT
repository-code: "{{REPO_URL}}"
keywords:
  - machine learning
  - tabular data
